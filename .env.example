# Non-secret identifiers
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCS_PAPER_NOTES_BUCKET=

# Prefer Application Default Credentials. If a service-account file is used,
# keep it outside this repository and provide only its absolute path here.
VERTEX_CREDENTIALS_PATH=

# Integration secrets: copy this file to .env and fill them locally.
NOTION_TOKEN=
NOTION_ROOT_PAGE_ID=
TODOIST_API_TOKEN=
TODOIST_PROJECT_ID=

# GitHub authentication should normally use `gh auth login`. If a token is
# needed for a headless deployment, keep it here and grant minimum scopes.
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_ALLOWED_REPOSITORIES=

# Web search provider selected during Hermes setup.
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
