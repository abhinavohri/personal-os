# Prefer Application Default Credentials. For a headless service account, use
# Google's standard variable and keep the JSON file outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=

# Integration secrets: copy this file to .env and fill them locally.
NOTION_TOKEN=
TODOIST_API_TOKEN=

# Export `gh auth token` here for local use, or use a narrowly scoped token for
# a headless deployment. The adapter itself is strictly read-only.
GITHUB_TOKEN=

# Phone uploader. Local mode is served privately through Tailscale Serve.
GCP_PROJECT_ID=
PAPER_NOTES_BUCKET=
UPLOADER_AUTH_MODE=local
UPLOAD_ACCESS_KEY=
# Only required when UPLOADER_AUTH_MODE=google.
GOOGLE_OAUTH_CLIENT_ID=
UPLOAD_ALLOWED_EMAIL=
UPLOADER_TIMEZONE=Asia/Kolkata

# Web search uses Vertex AI Google Search grounding, so there is no additional
# search-provider API key.
